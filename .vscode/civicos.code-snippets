  "FastAPI production endpoint": {
    "scope": "python",
    "prefix": "fastapi-prod-endpoint",
    "body": [
      "import json",
      "from fastapi import APIRouter, Depends, HTTPException, Request, status",
      "from loguru import logger",
      "from pydantic import BaseModel",
      "",
      "from app.services.guardrails.input_guard import InputGuard, InputValidationError",
      "from app.services.observability import telemetry",
      "",
      "router = APIRouter(tags=['your-tag'])",
      "input_guard = InputGuard()",
      "",
      "class RequestPayload(BaseModel):",
      "    field_one: str",
      "    field_two: int",
      "",
      "class ResponsePayload(BaseModel):",
      "    message: str",
      "    success: bool",
      "",
      "@router.post('/your-path', response_model=ResponsePayload, status_code=status.HTTP_200_OK)",
      "async def your_endpoint(request: Request, payload: RequestPayload = Depends()):",
      "    with telemetry.span('endpoint.your_endpoint', {'path': request.url.path, 'method': request.method}):",
      "        payload_data = payload.model_dump()",
      "        try:",
      "            guard_result = input_guard.sanitize(json.dumps(payload_data))",
      "        except InputValidationError as exc:",
      "            logger.warning('input_validation_failed', path=request.url.path, method=request.method, error=str(exc), payload=payload_data)",
      "            raise HTTPException(status_code=status.HTTP_422_UNPROCESSABLE_ENTITY, detail=str(exc))",
      "",
      "        logger.bind(path=request.url.path, method=request.method).info('request_received', payload=payload_data)",
      "",
      "        # Business logic goes here",
      "        response_data = ResponsePayload(message='Success', success=True)",
      "        logger.info('request_succeeded', path=request.url.path, method=request.method, response=response_data.model_dump())",
      "        return response_data"
    ],
    "description": "FastAPI endpoint snippet with OTEL span tracking, input guard validation, and structured JSON logging."
  }
