{
  "version": 2,
  "framework": "nextjs",
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/.next",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://civicos-480a.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://civicos-480a.onrender.com/health"
    }
  ]
}
